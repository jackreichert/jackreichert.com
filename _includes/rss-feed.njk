<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ feedTitle }}</title>
    <link>{{ feedHome }}</link>
    <atom:link href="{{ feedLink }}" rel="self" type="application/rss+xml"/>
    <description>{{ feedDescription }}</description>
    <language>en-us</language>
    <dc:creator>{{ site.author }}</dc:creator>
    {%- if feedPosts.length %}
    <lastBuildDate>{{ feedPosts[0].date | rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for post in feedPosts %}
    {%- set summary = post.data.description or "" %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | rfc822 }}</pubDate>
      <dc:creator>{{ site.author }}</dc:creator>
      {%- for cat in post.data.categories | realCategories %}
      <category>{{ cat }}</category>
      {%- endfor %}
      {%- if summary %}
      <description>{{ summary | excerptClean }}</description>
      {%- endif %}
      <content:encoded>{{ post.templateContent | absoluteUrls }}</content:encoded>
    </item>
    {%- endfor %}
  </channel>
</rss>
